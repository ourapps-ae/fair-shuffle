  "settings": [
    {
      "id": "source",
      "name": "Source",
      "type": "string",
      "required": false,
      "secret": false,
      "default": "secure"
    },
    {
      "id": "seed",
      "name": "Seed",
      "type": "string",
      "required": false,
      "secret": false
    }
  ]
}
